+static void tegra_exa_replace_scanout_bo(struct tegra_pixmap *priv,
+                                        struct drm_tegra_bo *scanout)
+{
+    struct drm_tegra_bo *old = priv->type == TEGRA_EXA_PIXMAP_TYPE_BO ?
+                              priv->bo : NULL;
+
+    /* RandR rebinds the existing screen pixmap on every front-buffer resize. */
+    if (old != scanout) {
+        priv->bo = drm_tegra_bo_ref(scanout);
+        if (old)
+            drm_tegra_bo_unref(old);
+    }
+    priv->type = TEGRA_EXA_PIXMAP_TYPE_BO;
+}
