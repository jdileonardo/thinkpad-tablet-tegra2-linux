+    if (err < 0)
+        return err;
+    /* Upstream selects the class implicitly; legacy command buffers need it. */
+    commands[0] = channel->class << 6;
+    memcpy(commands + 1, job->pushbuf->start, words * 4);
+    struct drm_tegra_cmdbuf cmdbuf = {
+        .handle = job->legacy_bo->handle, .words = words + 1,
+    };
+    struct drm_tegra_syncpt syncpt = {
+        .id = job->syncpt.id, .incrs = job->syncpt.increments,
+    };
+    struct drm_tegra_reloc *relocs = calloc(job->num_buffers, sizeof(*relocs));
+    if (job->num_buffers && !relocs)
+        return -ENOMEM;
+    for (unsigned i = 0; i < job->num_buffers; ++i) {
