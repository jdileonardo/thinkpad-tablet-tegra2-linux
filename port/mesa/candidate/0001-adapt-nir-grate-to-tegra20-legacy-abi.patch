+        relocs[i].target.handle = buffer->mapping;
+        relocs[i].target.offset = buffer->reloc.target_offset;
+        relocs[i].shift = buffer->reloc.shift;
+    }
+    struct drm_tegra_submit args = {
+        .context = channel->context, .num_syncpts = 1, .num_cmdbufs = 1,
+        .num_relocs = job->num_buffers, .timeout = 1000,
+        .syncpts = (uintptr_t)&syncpt, .cmdbufs = (uintptr_t)&cmdbuf,
+        .relocs = (uintptr_t)relocs,
+    };
+    err = ioctl(drm->fd, DRM_IOCTL_TEGRA_SUBMIT, &args);
+    free(relocs);
     if (err < 0)
         return -errno;
