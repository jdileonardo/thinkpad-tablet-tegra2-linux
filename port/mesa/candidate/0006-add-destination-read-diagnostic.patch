+/* Diagnostic epilogue: read a render target through PSEQ, then copy its
+ * packed FX10 channels to the color output. Keep this opt-in until the
+ * destination-read instruction has been validated on Tegra20.
+ */
+static void
+grate_debug_pseq_read(struct grate_fp_shader *fp, uint32_t word)
+{
+   struct fp_instr *last = list_last_entry(&fp->fp_instructions, struct fp_instr, link);
+   struct fp_instr *inst = CALLOC_STRUCT(fp_instr);
+   struct fp_alu_instr_packet *pkt = CALLOC_STRUCT(fp_alu_instr_packet);
+   list_inithead(&inst->link);
+   list_inithead(&pkt->link);
+   inst->pseq = word;
+   inst->alu_sched.address = list_length(&fp->alu_instructions);
+   inst->alu_sched.num_instructions = 1;
+   inst->dw = last->dw;
+   last->dw.enable = false;
+   unsigned source = (word & 2) ? 2 : 0;
+   for (unsigned i = 0; i < 4; ++i) {
+      pkt->slots[i] = (struct fp_alu_instr){
+         .op = FP_ALU_OP_MAD, .condition = FP_CONDITION_ALWAYS,
+         .dst = { .index = 2 + i / 2, .write_low_sub_reg = !(i & 1),
+                  .write_high_sub_reg = i & 1 },
+         .src = {
+            { .index = source + i / 2, .datatype = FP_DATATYPE_FIXED10,
+              .sub_reg_select_high = i & 1 },
+            { .index = 31, .datatype = FP_DATATYPE_FIXED10,
+              .sub_reg_select_high = true },
+            { .index = 31, .datatype = FP_DATATYPE_FIXED10 },
+            { .index = 31, .datatype = FP_DATATYPE_FIXED10 },
+         },
+      };
+   }
+   list_addtail(&pkt->link, &fp->alu_instructions);
+   list_addtail(&inst->link, &fp->fp_instructions);
+}
