+/* DRI3 v1: single-plane linear buffers. No page-flipping advertised. */
+static int TegraDRI3Open(ClientPtr client, ScreenPtr screen,
+                         RRProviderPtr provider, int *fd)
+{
+    TegraPtr tegra = TegraPTR(xf86ScreenToScrn(screen));
+    char *path = drmGetRenderDeviceNameFromFd(tegra->fd);
+    int render_fd;
+
+    if (!path)
+        return BadMatch;
+    render_fd = open(path, O_RDWR | O_CLOEXEC);
+    free(path);
+    if (render_fd < 0)
+        return BadAlloc;
+    *fd = render_fd;
+    return Success;
+}
+
+static PixmapPtr TegraDRI3PixmapFromFD(ScreenPtr screen, int fd,
+                                       CARD16 width, CARD16 height,
+                                       CARD16 stride, CARD8 depth, CARD8 bpp)
+{
+    TegraPtr tegra = TegraPTR(xf86ScreenToScrn(screen));
+    struct drm_tegra_bo *bo = NULL;
+    struct tegra_pixmap *priv;
+    PixmapPtr pixmap;
+    uint32_t size;
+    struct drm_tegra_bo_tiling tiling;
+    uint64_t needed;
+
+    if (!width || !height ||
+        !((depth == 16 && bpp == 16) ||
+          ((depth == 24 || depth == 32) && bpp == 32)) ||
+        stride < (uint32_t)width * (bpp / 8) || (stride & 15))
+        return NULL;
+
+    /* EXA's block operations may access the aligned bottom rows. */
+    needed = (uint64_t)stride * tegra_height_hw_aligned(height, bpp);
+    if (drm_tegra_bo_from_dmabuf(&bo, tegra->drm, fd, 0))
+        return NULL;
+    if (drm_tegra_bo_get_size(bo, &size) || needed > size ||
+        drm_tegra_bo_get_tiling(bo, &tiling) || tiling.mode)
+        goto fail_bo;
+
+    pixmap = screen->CreatePixmap(screen, 0, 0, depth, 0);
+    if (!pixmap)
+        goto fail_bo;
+    if (!screen->ModifyPixmapHeader(pixmap, width, height, depth, bpp,
+                                    stride, NULL)) {
+        screen->DestroyPixmap(pixmap);
+        goto fail_bo;
+    }
+    priv = exaGetPixmapDriverPrivate(pixmap);
+    priv->bo = bo;
+    priv->type = TEGRA_EXA_PIXMAP_TYPE_BO;
+    priv->tegra_data = true;
+    priv->offscreen = true;
+    priv->accel = true;
+    priv->dri = true;
+    priv->base = pixmap;
+    drm_tegra_bo_forbid_caching(bo);
+    return pixmap;
+
+fail_bo:
+    drm_tegra_bo_unref(bo);
+    return NULL;
+}
+
+static int TegraDRI3FDFromPixmap(ScreenPtr screen, PixmapPtr pixmap,
+                                 CARD16 *stride, CARD32 *size)
+{
+    TegraPtr tegra = TegraPTR(xf86ScreenToScrn(screen));
+    struct tegra_pixmap *priv = exaGetPixmapDriverPrivate(pixmap);
+    struct tegra_pixmap dedicated = { .accel = true, .dri = true };
+    uint32_t fd, bo_size;
+    void *old_data, *new_data;
+    unsigned int y, row_bytes;
+
+    if (!priv || !priv->tegra_data || !priv->accel ||
+        pixmap->devKind <= 0 || pixmap->devKind > UINT16_MAX)
+        return -1;
+    tegra_exa_thaw_pixmap(pixmap, true);
+    tegra_exa_flush_deferred_operations(pixmap, true, true, true);
+    if (priv->type > TEGRA_EXA_PIXMAP_TYPE_FALLBACK)
+        TEGRA_PIXMAP_WAIT_ALL_FENCES(priv);
+
+    /* Pooled BOs contain other pixmaps; never export those allocations. */
+    if (priv->type != TEGRA_EXA_PIXMAP_TYPE_BO) {
+        if (!tegra_exa_pixmap_allocate_from_bo(tegra, &dedicated,
+                                               tegra_exa_pixmap_size(priv)))
+            return -1;
+        if (drm_tegra_bo_map(dedicated.bo, &new_data)) {
+            drm_tegra_bo_unref(dedicated.bo);
+            return -1;
+        }
+        if (!tegra_exa_prepare_cpu_access(pixmap, EXA_PREPARE_SRC,
+                                          &old_data, true)) {
+            drm_tegra_bo_unmap(dedicated.bo);
+            drm_tegra_bo_unref(dedicated.bo);
+            return -1;
+        }
+        row_bytes = pixmap->drawable.width *
+                    (pixmap->drawable.bitsPerPixel / 8);
+        memset(new_data, 0, tegra_exa_pixmap_size(priv));
+        for (y = 0; y < pixmap->drawable.height; ++y)
+            memcpy((char *)new_data + y * pixmap->devKind,
+                   (char *)old_data + y * pixmap->devKind, row_bytes);
+        /* Prevent finish_access from putting the pixmap back in the fridge. */
+        priv->dri = true;
+        tegra_exa_finish_cpu_access(pixmap, EXA_PREPARE_SRC);
+        if (priv->type == TEGRA_EXA_PIXMAP_TYPE_POOL)
+            tegra_exa_pixmap_pool_free_entry(&priv->pool_entry);
+        else if (priv->type == TEGRA_EXA_PIXMAP_TYPE_FALLBACK) {
+            free(priv->fallback);
+            tegra->exa->release_count++;
+        }
+        drm_tegra_bo_unmap(dedicated.bo);
+        priv->bo = dedicated.bo;
+        priv->type = TEGRA_EXA_PIXMAP_TYPE_BO;
+        priv->sparse = dedicated.sparse;
+        memset(priv->fence_read, 0, sizeof(priv->fence_read));
+        memset(priv->fence_write, 0, sizeof(priv->fence_write));
+    }
+    if (drm_tegra_bo_to_dmabuf(priv->bo, &fd))
+        return -1;
+    priv->dri = true;
+    /* External clients can change every pixel; don't retain solid/alpha hints. */
+    priv->state.solid_fill = false;
+    priv->state.alpha_0 = false;
+    drm_tegra_bo_forbid_caching(priv->bo);
+    *stride = pixmap->devKind;
+    drm_tegra_bo_get_size(priv->bo, &bo_size);
+    *size = bo_size;
+    return fd;
+}
+
+static void TegraPresentFlush(WindowPtr window)
+{
+    ScreenPtr screen = window->drawable.pScreen;
+    PixmapPtr pixmap = screen->GetWindowPixmap(window);
+    struct tegra_pixmap *priv = exaGetPixmapDriverPrivate(pixmap);
+
+    if (priv && priv->type > TEGRA_EXA_PIXMAP_TYPE_FALLBACK) {
+        tegra_exa_flush_deferred_operations(pixmap, true, true, true);
+        TEGRA_PIXMAP_WAIT_ALL_FENCES(priv);
+    }
+}
+
+static const dri3_screen_info_rec tegra_dri3_info = {
+    .version = 1,
+    .open_client = TegraDRI3Open,
+    .pixmap_from_fd = TegraDRI3PixmapFromFD,
+    .fd_from_pixmap = TegraDRI3FDFromPixmap,
+};
+
+static present_screen_info_rec tegra_present_info = {
+    .version = PRESENT_SCREEN_INFO_VERSION,
+    .flush = TegraPresentFlush,
+};
+#endif
+
+Bool TegraDRI3ScreenInit(ScreenPtr screen)
+{
+#ifdef DRI3
+    ScrnInfoPtr scrn = xf86ScreenToScrn(screen);
+    TegraPtr tegra = TegraPTR(scrn);
+
+    if (tegra->exa && miSyncShmScreenInit(screen) && present_screen_init(screen, &tegra_present_info) &&
+        dri3_screen_init(screen, &tegra_dri3_info)) {
+        xf86DrvMsg(scrn->scrnIndex, X_INFO,
+                   "DRI3 enabled (linear buffers, Present copy path)\n");
+        return TRUE;
+    }
+    xf86DrvMsg(scrn->scrnIndex, X_WARNING, "DRI3 initialization failed\n");
+#endif
+    return FALSE;
+}
